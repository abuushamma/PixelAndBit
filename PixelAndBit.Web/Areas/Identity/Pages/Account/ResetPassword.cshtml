@page
@model PixelAndBit.Web.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
    var toastErr = TempData["pb_toast_error"]?.ToString();
}

<div class="pb-section pb-fade">
    <div class="pb-auth-shell mx-auto">
        <div class="text-center mb-4">
            <h1 class="h2 font-orbitron mb-2">Set a new password</h1>
            <p class="text-muted mb-0">Choose a strong password you haven't used before.</p>
        </div>

        <div class="pb-surface pb-card pb-auth-card p-4 p-md-5">
            @if (!string.IsNullOrWhiteSpace(toastErr))
            {
                <div class="mb-3 p-3" style="background: rgba(255, 80, 120, 0.10); border: 1px solid rgba(255, 80, 120, 0.35); border-radius: 14px;">
                    <div style="color: rgba(255,255,255,0.92);">@toastErr</div>
                </div>
            }

            <form method="post" class="d-grid gap-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div>
                    <label asp-for="Input.Password" class="form-label fw-semibold text-muted"></label>
                    <input asp-for="Input.Password" class="form-control pb-input" autocomplete="new-password" autofocus />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold text-muted"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control pb-input" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary pb-btn-glow pb-auth-btn">Reset password</button>

                <div class="text-center">
                    <a class="small text-muted pb-auth-link" asp-page="./Login">Back to sign in</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
