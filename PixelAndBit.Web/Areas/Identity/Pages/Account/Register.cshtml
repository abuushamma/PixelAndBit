@page
@model PixelAndBit.Web.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create account";
}

<div class="pb-section pb-fade">
    <div class="pb-auth-shell mx-auto">
        <div class="text-center mb-4">
            <h1 class="h2 font-orbitron mb-2">Create your account</h1>
            <p class="text-muted mb-0">Join Pixel &amp; Bit to book repairs, track orders, and manage your account.</p>
        </div>

        <div class="pb-surface pb-card pb-auth-card p-4 p-md-5">
            <form method="post" class="d-grid gap-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div>
                    <label asp-for="Input.Email" class="form-label fw-semibold text-muted"></label>
                    <input asp-for="Input.Email" class="form-control pb-input" autocomplete="username" inputmode="email" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="Input.Password" class="form-label fw-semibold text-muted"></label>
                    <input asp-for="Input.Password" class="form-control pb-input" autocomplete="new-password" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold text-muted"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control pb-input" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary pb-btn-glow pb-auth-btn">Create account</button>

                <div class="text-center">
                    <a class="small text-muted pb-auth-link"
                       asp-page="./Login"
                       asp-route-returnUrl="@Model.ReturnUrl">
                        Already have an account? Sign in
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
