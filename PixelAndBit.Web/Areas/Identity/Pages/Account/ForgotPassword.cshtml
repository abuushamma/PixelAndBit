@page
@model PixelAndBit.Web.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="pb-section pb-fade">
    <div class="pb-auth-shell mx-auto">
        <div class="text-center mb-4">
            <h1 class="h2 font-orbitron mb-2">Forgot your password?</h1>
            <p class="text-muted mb-0">Enter your email and we'll send you a 5-digit code to reset it.</p>
        </div>

        <div class="pb-surface pb-card pb-auth-card p-4 p-md-5">
            <form method="post" class="d-grid gap-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div>
                    <label asp-for="Input.Email" class="form-label fw-semibold text-muted"></label>
                    <input asp-for="Input.Email" class="form-control pb-input" autocomplete="username" inputmode="email" autofocus />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary pb-btn-glow pb-auth-btn">Send reset code</button>

                <div class="text-center">
                    <a class="small text-muted pb-auth-link" asp-page="./Login">Back to sign in</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
