@model IReadOnlyList<PixelAndBit.Domain.Entities.Booking>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = "Admin — Repair Requests";
    var q = (ViewBag.Q as string) ?? "";
}

<div class="pb-section pb-fade">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h1 class="h2 mb-0 font-orbitron">Admin — Repair Requests</h1>
        <span class="badge" style="background: rgba(157,78,221,0.16); border: 1px solid rgba(157,78,221,0.5); color: var(--text-white);">
            @Model.Count request@(Model.Count == 1 ? "" : "s")
        </span>
    </div>

    <form method="get" class="pb-surface pb-card p-3 mb-4 pb-fade" style="backdrop-filter: blur(15px);">
        <div class="d-flex flex-column flex-md-row gap-2 align-items-stretch">
            <input name="q" value="@q" class="form-control pb-input" placeholder="Search by ticket / customer / phone…" />
            <button class="btn btn-primary pb-btn-glow" type="submit" style="min-width: 10rem;">Search</button>
            @if (!string.IsNullOrWhiteSpace(q))
            {
                <a class="btn btn-outline-primary pb-btn-glow" asp-controller="Booking" asp-action="Admin" style="min-width: 10rem;">Clear</a>
            }
        </div>
    </form>

    <div class="pb-surface pb-card p-3 p-md-4">
        <div class="table-responsive">
            <table class="table table-dark align-middle mb-0" style="--bs-table-bg: transparent; --bs-table-striped-bg: rgba(255,255,255,0.03);">
                <thead>
                <tr style="color: rgba(255,255,255,0.85);">
                    <th>Ticket</th>
                    <th>Customer</th>
                    <th>Phone</th>
                    <th>Device</th>
                    <th>Status</th>
                    <th class="text-end">Est. cost</th>
                    <th class="text-end">Created</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var b in Model)
                {
                    var badgeStyle = b.Status switch
                    {
                        PixelAndBit.Domain.Enums.BookingStatus.ReadyForPickup => "background: rgba(0,255,136,0.14); border: 1px solid rgba(0,255,136,0.50); color: #B7FFD6;",
                        PixelAndBit.Domain.Enums.BookingStatus.InProgress     => "background: rgba(255,198,0,0.14); border: 1px solid rgba(255,198,0,0.50); color: #FFE7A6;",
                        PixelAndBit.Domain.Enums.BookingStatus.Received       => "background: rgba(0,160,255,0.14); border: 1px solid rgba(0,160,255,0.45); color: #C7EBFF;",
                        PixelAndBit.Domain.Enums.BookingStatus.Completed      => "background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); color: rgba(255,255,255,0.8);",
                        _                                                    => "background: rgba(157,78,221,0.14); border: 1px solid rgba(157,78,221,0.45); color: rgba(255,255,255,0.85);"
                    };

                    <tr class="pb-fade">
                        <td class="font-orbitron" style="letter-spacing: 0.05em;">@b.TicketReference</td>
                        <td>@b.CustomerName</td>
                        <td>@b.PhoneNumber</td>
                        <td style="max-width: 24rem;">
                            <div style="color: rgba(255,255,255,0.9);">@b.DeviceModel</div>
                            <div class="text-muted small text-truncate">@b.IssueDescription</div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="badge pb-status-badge" data-booking-id="@b.Id" style="@badgeStyle; transition: box-shadow 220ms ease, transform 220ms ease;">
                                    @b.Status
                                </span>

                                <select class="form-select form-select-sm pb-input pb-status-select"
                                        style="width: 12.5rem;"
                                        data-booking-id="@b.Id"
                                        aria-label="Update status">
                                    @foreach (var s in Enum.GetValues<PixelAndBit.Domain.Enums.BookingStatus>())
                                    {
                                        if (s == b.Status)
                                        {
                                            <option selected value="@s">@s</option>
                                        }
                                        else
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    }
                                </select>
                            </div>
                        </td>
                        <td class="text-end">@b.EstimatedCost.ToString("0.##") JOD</td>
                        <td class="text-end text-muted">@b.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const token = '@Antiforgery.GetAndStoreTokens(Context).RequestToken';

            const badgeStyle = (status) => {
                switch (status) {
                    case "ReadyForPickup": return "background: rgba(0,255,136,0.14); border: 1px solid rgba(0,255,136,0.50); color: #B7FFD6;";
                    case "InProgress":     return "background: rgba(255,198,0,0.14); border: 1px solid rgba(255,198,0,0.50); color: #FFE7A6;";
                    case "Received":       return "background: rgba(0,160,255,0.14); border: 1px solid rgba(0,160,255,0.45); color: #C7EBFF;";
                    case "Completed":      return "background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); color: rgba(255,255,255,0.8);";
                    default:               return "background: rgba(157,78,221,0.14); border: 1px solid rgba(157,78,221,0.45); color: rgba(255,255,255,0.85);";
                }
            };

            const setBusy = (el, busy) => {
                el.disabled = busy;
                el.style.opacity = busy ? "0.7" : "1";
            };

            const selects = Array.from(document.querySelectorAll(".pb-status-select"));
            selects.forEach(sel => {
                sel.addEventListener("change", async () => {
                    const bookingId = sel.dataset.bookingId;
                    const status = sel.value;

                    setBusy(sel, true);

                    try {
                        const res = await fetch("/Booking/UpdateStatus", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": token
                            },
                            body: JSON.stringify({ bookingId, status })
                        });

                        if (!res.ok) throw new Error("Update failed");

                        const badge = document.querySelector(`.pb-status-badge[data-booking-id="${bookingId}"]`);
                        if (badge) {
                            badge.setAttribute("style", badgeStyle(status) + " transition: box-shadow 220ms ease, transform 220ms ease;");
                            badge.textContent = status;
                            badge.style.boxShadow = "0 0 16px rgba(157,78,221,0.35)";
                            badge.style.transform = "translateY(-1px)";
                            setTimeout(() => {
                                badge.style.boxShadow = "";
                                badge.style.transform = "";
                            }, 320);
                        }
                    } catch (e) {
                        alert("Could not update status. Please retry.");
                    } finally {
                        setBusy(sel, false);
                    }
                });
            });
        })();
    </script>
}

