@{
    ViewData["Title"] = "Repair Request Confirmed";
}

<div class="pb-section pb-fade">
    <div class="mx-auto text-center" style="max-width: 28rem;">
        <div class="pb-surface pb-card pb-fade">
            <div class="p-5">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-4 pb-receipt-pop"
                     style="width: 5rem; height: 5rem; background: rgba(157,78,221,0.16); border: 1px solid rgba(157,78,221,0.55); box-shadow: 0 0 22px rgba(157,78,221,0.22);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/>
                    </svg>
                </div>
                <h1 class="h3 mb-2 font-orbitron">Repair request confirmed</h1>
                <p class="text-muted mb-4">Save this digital receipt for pickup and follow-up.</p>
                <div class="p-4 mb-4" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(157,78,221,0.25); border-radius: 14px;">
                    <div class="small text-muted text-uppercase mb-1">Ticket reference</div>
                    <div class="fs-3 font-monospace fw-bold text-primary">@ViewBag.Ticket</div>
                    <div class="mt-3 pt-3" style="border-top: 1px solid rgba(157,78,221,0.18); text-align: left;">
                        <div class="small text-muted text-uppercase mb-1">Pixel&amp;Bit</div>
                        <div class="small" style="color: rgba(255,255,255,0.85);">Amman, Jordan</div>
                        <div class="small" style="color: rgba(255,255,255,0.85);">0785291744</div>
                    </div>
                </div>
                <a class="btn btn-outline-primary w-100 mb-2 pb-btn-glow" asp-controller="Store" asp-action="Index">Continue to store</a>
                <a class="btn btn-primary w-100 pb-btn-glow" asp-controller="Booking" asp-action="Index">Create another request</a>
            </div>
        </div>
    </div>
</div>
