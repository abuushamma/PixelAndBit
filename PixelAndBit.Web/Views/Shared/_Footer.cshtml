@inject Microsoft.Extensions.Localization.IStringLocalizer<PixelAndBit.Web.SharedResource> T

<div class="pb-footer-backtop text-center">
    <button type="button" class="btn btn-sm pb-footer-backtop__btn" id="pb-back-to-top" aria-label="@T["Footer.BackToTop.Aria"]">
        @T["Footer.BackToTop"]
    </button>
</div>

<footer class="pb-footer-surface">
    <div class="container py-4 py-lg-5">
        <div class="row g-4 g-lg-5">
            <div class="col-6 col-md-3">
                <a class="text-decoration-none" asp-controller="Home" asp-action="Index" aria-label="@T["Nav.BrandHome"]">
                    <h3 class="pb-footer__col-title pb-footer__brand-title">@T["Nav.BrandName"]</h3>
                </a>
                <ul class="pb-footer__list list-unstyled">
                    <li><a class="pb-footer__link" asp-controller="Home" asp-action="Index" asp-fragment="value">@T["Footer.Link.AboutUs"]</a></li>
                    <li><a class="pb-footer__link" asp-controller="Home" asp-action="Index" asp-fragment="services">@T["Footer.Link.OurServices"]</a></li>
                    <li><a class="pb-footer__link" asp-controller="Home" asp-action="Index" asp-fragment="features">@T["Footer.Link.WhyChooseUs"]</a></li>
                    <li><a class="pb-footer__link" asp-controller="Home" asp-action="Contact">@T["Nav.Contact"]</a></li>
                </ul>
            </div>
            <div class="col-6 col-md-3">
                <h3 class="pb-footer__col-title">@T["Footer.Column.Repair"]</h3>
                <ul class="pb-footer__list list-unstyled">
                    <li><a class="pb-footer__link" asp-controller="Booking" asp-action="Index">@T["Footer.Link.Repair.Ps5"]</a></li>
                    <li><a class="pb-footer__link" asp-controller="Booking" asp-action="Index">@T["Footer.Link.Repair.Laptop"]</a></li>
                    <li><a class="pb-footer__link" asp-controller="Booking" asp-action="Index">@T["Footer.Link.Repair.PC"]</a></li>
                    <li><a class="pb-footer__link" asp-controller="Booking" asp-action="Index">@T["Footer.Link.Repair.Smartphone"]</a></li>
                    <li><a class="pb-footer__link" asp-controller="Store" asp-action="Index">@T["Footer.Link.Repair.Thermal"]</a></li>
                </ul>
            </div>
            <div class="col-6 col-md-3">
                <h3 class="pb-footer__col-title">@T["Footer.Column.Support"]</h3>
                <ul class="pb-footer__list list-unstyled">
                    <li><a class="pb-footer__link" asp-controller="Booking" asp-action="Index">@T["Nav.BookRepair"]</a></li>
                    <li><a class="pb-footer__link" asp-controller="Booking" asp-action="Track">@T["Nav.Track"]</a></li>
                    <li><a class="pb-footer__link" asp-controller="Home" asp-action="Privacy" asp-fragment="warranty">@T["Footer.Link.Warranty"]</a></li>
                    <li><a class="pb-footer__link" href="#site-faq">@T["Footer.Link.Faq"]</a></li>
                </ul>
            </div>
            <div class="col-6 col-md-3">
                <h3 class="pb-footer__col-title">@T["Footer.Column.Visit"]</h3>
                <p class="mb-2">
                    <a class="pb-footer__link pb-footer__link--visit-map d-inline-block"
                       href="https://maps.app.goo.gl/KW6ZUNXVunfN9ZGYA"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="@T["Contact.OpenMaps"]">@T["Footer.Visit.Address"]</a>
                </p>
                <p class="mb-2">
                    <a class="pb-footer__link pb-ltr-inline" href="https://wa.me/962785291744" target="_blank" rel="noopener noreferrer" aria-label="@T["Contact.WhatsAppSupport"]">
                        <span class="pb-ltr-inline">@T["Footer.Visit.Phone"]</span>
                    </a>
                </p>
                <p class="mb-2">
                    <a class="pb-footer__link" href="https://www.instagram.com/pixelbit.jo/" target="_blank" rel="noopener noreferrer">@T["Footer.Visit.Instagram"]</a>
                </p>
                <p class="mb-0">
                    <a class="pb-footer__link" asp-controller="Home" asp-action="Contact" asp-fragment="store-hours">@T["Footer.Visit.Hours"]</a>
                </p>
            </div>
        </div>
        <div class="pb-footer-legal d-flex flex-wrap align-items-center justify-content-between gap-2 pt-4 mt-4">
            <span class="text-muted small">@T["Footer.Copyright"]</span>
            <a class="pb-footer-legal__link" asp-controller="Home" asp-action="Privacy">@T["Footer.Privacy"]</a>
        </div>
    </div>
</footer>
