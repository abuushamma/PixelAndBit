@using PixelAndBit.Domain.Enums
@model List<PixelAndBit.Domain.Entities.Order>

@{
    ViewData["Title"] = "Orders";
}

<div class="pb-section pb-fade">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
        <div>
            <div class="text-muted small text-uppercase">Admin</div>
            <h1 class="h3 font-orbitron mb-0">Orders</h1>
        </div>
        <a class="btn btn-outline-primary pb-btn-glow" asp-controller="Admin" asp-action="Index">Back to dashboard</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="pb-surface pb-card p-4">
            <div class="text-muted">No orders yet.</div>
        </div>
    }
    else
    {
        <div class="pb-surface pb-card p-3 p-md-4">
            <div class="table-responsive">
                <table class="table table-dark table-borderless align-middle mb-0" style="--bs-table-bg: transparent;">
                    <thead style="color: rgba(255,255,255,0.75);">
                    <tr>
                        <th class="font-orbitron" style="letter-spacing:.08em;">Order</th>
                        <th>Date</th>
                        <th>User</th>
                        <th class="text-end">Items</th>
                        <th class="text-end">Total</th>
                        <th>Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var o in Model)
                    {
                        var itemsCount = o.Items?.Sum(i => i.Quantity) ?? 0;
                        <tr style="border-top: 1px solid rgba(157,78,221,0.14);">
                            <td>
                                <div class="font-orbitron" style="color: rgba(255,255,255,0.92);">@o.Id.ToString()[..8]</div>
                                <div class="small text-muted">ID: @o.Id</div>
                            </td>
                            <td style="white-space: nowrap;">
                                @o.OrderDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            </td>
                            <td>
                                <span class="text-muted">@((string.IsNullOrWhiteSpace(o.UserId) ? "Guest" : o.UserId))</span>
                            </td>
                            <td class="text-end">@itemsCount</td>
                            <td class="text-end font-orbitron text-primary">@o.TotalAmount.ToString("0.##") JOD</td>
                            <td>
                                @{
                                    var badgeStyle = o.Status switch
                                    {
                                        OrderStatus.Completed => "background: rgba(46,243,210,0.14); border: 1px solid rgba(46,243,210,0.40); color: rgba(46,243,210,0.92);",
                                        OrderStatus.Cancelled => "background: rgba(255,80,120,0.12); border: 1px solid rgba(255,80,120,0.35); color: rgba(255,160,180,0.92);",
                                        _ => "background: rgba(157,78,221,0.14); border: 1px solid rgba(157,78,221,0.40); color: rgba(255,255,255,0.88);"
                                    };
                                }
                                <span class="badge" style="@badgeStyle">@o.Status</span>
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary pb-btn-glow"
                                   asp-controller="Admin" asp-action="OrderDetails" asp-route-id="@o.Id">Open</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

