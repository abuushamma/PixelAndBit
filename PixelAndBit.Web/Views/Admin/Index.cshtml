@model PixelAndBit.Web.Models.AdminDashboardVm

@{
    ViewData["Title"] = "Admin Command Center";
    var max = Math.Max(1, Math.Max(Model.TotalProducts, Math.Max(Model.PendingRepairs, Model.TotalRequests)));
    string Bar(int value) => $"width:{Math.Clamp((int)Math.Round((value / (double)max) * 100), 6, 100)}%";
}

<div class="pb-section pb-fade">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h2 font-orbitron mb-1">Admin Command Center</h1>
            <div class="text-muted">Live overview of Pixel&amp;Bit inventory &amp; repairs.</div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary pb-btn-glow" asp-controller="Booking" asp-action="Admin">Manage bookings</a>
            <a class="btn btn-outline-primary pb-btn-glow" asp-controller="Admin" asp-action="Orders">Orders</a>
            <a class="btn btn-primary pb-btn-glow" asp-controller="Admin" asp-action="ProductCreate">Add product</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="pb-surface pb-card p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="text-muted small text-uppercase">Total Products</div>
                    <span class="badge" style="background: rgba(157,78,221,0.14); border: 1px solid rgba(157,78,221,0.45); color: rgba(255,255,255,0.9);">Inventory</span>
                </div>
                <div class="font-orbitron mt-2" style="font-size: 1.8rem;">@Model.TotalProducts</div>
                <div class="mt-3" style="height: 8px; background: rgba(255,255,255,0.06); border-radius: 999px; overflow: hidden;">
                    <div style="@Bar(Model.TotalProducts); height: 100%; background: rgba(157,78,221,0.75); box-shadow: 0 0 14px rgba(157,78,221,0.35);"></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="pb-surface pb-card p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="text-muted small text-uppercase">Pending Repairs</div>
                    <span class="badge" style="background: rgba(157,78,221,0.14); border: 1px solid rgba(157,78,221,0.45); color: rgba(255,255,255,0.9);">Queue</span>
                </div>
                <div class="font-orbitron mt-2" style="font-size: 1.8rem;">@Model.PendingRepairs</div>
                <div class="mt-3" style="height: 8px; background: rgba(255,255,255,0.06); border-radius: 999px; overflow: hidden;">
                    <div style="@Bar(Model.PendingRepairs); height: 100%; background: rgba(157,78,221,0.75); box-shadow: 0 0 14px rgba(157,78,221,0.35);"></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="pb-surface pb-card p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="text-muted small text-uppercase">Total Requests</div>
                    <span class="badge" style="background: rgba(157,78,221,0.14); border: 1px solid rgba(157,78,221,0.45); color: rgba(255,255,255,0.9);">Bookings</span>
                </div>
                <div class="font-orbitron mt-2" style="font-size: 1.8rem;">@Model.TotalRequests</div>
                <div class="mt-3" style="height: 8px; background: rgba(255,255,255,0.06); border-radius: 999px; overflow: hidden;">
                    <div style="@Bar(Model.TotalRequests); height: 100%; background: rgba(157,78,221,0.75); box-shadow: 0 0 14px rgba(157,78,221,0.35);"></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="pb-surface pb-card p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="text-muted small text-uppercase">Total Users</div>
                    <span class="badge" style="background: rgba(100,233,255,0.10); border: 1px solid rgba(100,233,255,0.35); color: rgba(255,255,255,0.9);">Identity</span>
                </div>
                <div class="font-orbitron mt-2" style="font-size: 1.8rem;">@Model.TotalUsers</div>
                <div class="mt-3 d-grid">
                    <a class="btn btn-outline-primary pb-btn-glow" asp-controller="Admin" asp-action="Users">View users</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="pb-surface pb-card p-4">
                <div class="text-muted small text-uppercase mb-2">Quick Actions</div>
                <div class="d-grid gap-2">
                    <a class="btn btn-primary pb-btn-glow" asp-controller="Booking" asp-action="Admin">Manage Bookings</a>
                    <a class="btn btn-outline-primary pb-btn-glow" asp-controller="Admin" asp-action="Orders">Manage Orders</a>
                    <a class="btn btn-outline-primary pb-btn-glow" asp-controller="Admin" asp-action="Products">Manage Products</a>
                    <a class="btn btn-outline-primary pb-btn-glow" asp-controller="Admin" asp-action="Users">Manage Users</a>
                </div>
                <div class="mt-3 small text-muted">Tip: Use ticket references to update statuses fast.</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-12 col-lg-6">
            <div class="pb-surface pb-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 font-orbitron mb-0">Revenue Breakdown</h2>
                    <span class="badge" style="background: rgba(157,78,221,0.14); border: 1px solid rgba(157,78,221,0.45); color: rgba(255,255,255,0.9);">JOD</span>
                </div>

                <div class="d-flex justify-content-between align-items-center py-2">
                    <div class="text-muted">Services (Completed repairs)</div>
                    <div class="font-orbitron text-primary">@Model.ServicesRevenueJod.ToString("0.##")</div>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2" style="border-top: 1px solid rgba(157,78,221,0.18);">
                    <div class="text-muted">Sales</div>
                    <div class="font-orbitron text-primary">@Model.SalesRevenueJod.ToString("0.##")</div>
                </div>
                <div class="small text-muted mt-3">Sales revenue counts completed orders.</div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="pb-surface pb-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 font-orbitron mb-0">Device Insights</h2>
                    <span class="badge" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); color: rgba(255,255,255,0.8);">Top</span>
                </div>

                @if (Model.TopDeviceModels.Count == 0)
                {
                    <div class="text-muted">No repair requests yet.</div>
                }
                else
                {
                    <div class="d-grid gap-2">
                        @foreach (var item in Model.TopDeviceModels)
                        {
                            <div class="d-flex justify-content-between align-items-center"
                                 style="padding: 0.65rem 0.9rem; border: 1px solid rgba(157,78,221,0.18); border-radius: 14px; background: rgba(255,255,255,0.03);">
                                <div style="color: rgba(255,255,255,0.9);">@item.DeviceModel</div>
                                <span class="badge" style="background: rgba(157,78,221,0.14); border: 1px solid rgba(157,78,221,0.45); color: rgba(255,255,255,0.9);">
                                    @item.Count request@(item.Count == 1 ? "" : "s")
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

