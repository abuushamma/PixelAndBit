@model IReadOnlyList<PixelAndBit.Application.Interfaces.CartLine>

@{
    ViewData["Title"] = "Cart";
    var total = (decimal)(ViewBag.Total ?? 0m);
}

<div class="pb-section pb-fade">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h1 class="h2 font-orbitron mb-0">Shopping Cart</h1>
        <span class="badge" style="background: rgba(195,32,173,0.14); border: 1px solid rgba(195,32,173,0.45); color: rgba(255,255,255,0.9);">
            @Model.Sum(x => x.Quantity) item@(Model.Sum(x => x.Quantity) == 1 ? "" : "s")
        </span>
    </div>

    <div class="pb-surface pb-card p-3 p-md-4 pb-fade" style="backdrop-filter: blur(15px);">
        @if (Model.Count == 0)
        {
            <div class="text-muted">Your cart is empty. Browse the store to add items.</div>
            <div class="mt-3">
                <a class="btn btn-primary pb-btn-glow" asp-controller="Store" asp-action="Index">Browse store</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark align-middle mb-0" style="--bs-table-bg: transparent; --bs-table-striped-bg: rgba(255,255,255,0.03);">
                    <thead>
                    <tr style="color: rgba(255,255,255,0.85);">
                        <th>Item</th>
                        <th class="text-end">Unit</th>
                        <th class="text-end">Qty</th>
                        <th class="text-end">Line total</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var line in Model)
                    {
                        <tr>
                            <td>
                                <div class="font-orbitron" style="letter-spacing: 0.04em;">@line.Product.Name</div>
                                <div class="text-muted small text-truncate">@line.Product.Description</div>
                            </td>
                            <td class="text-end">@line.Product.Price.ToString("0.##") JOD</td>
                            <td class="text-end">@line.Quantity</td>
                            <td class="text-end">@((line.Product.Price * line.Quantity).ToString("0.##")) JOD</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4 pt-4 flex-wrap gap-2"
                 style="border-top: 1px solid rgba(195,32,173,0.18);">
                <form asp-action="Clear" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary pb-btn-glow">Clear cart</button>
                </form>

                <div class="text-end">
                    <div class="text-muted small text-uppercase">Total</div>
                    <div class="font-orbitron" style="font-size: 1.6rem;">@total.ToString("0.##") JOD</div>
                </div>
            </div>

            <form asp-action="Confirm" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary btn-lg w-100 pb-btn-glow">
                    Confirm Order (Pay at Store)
                </button>
            </form>
        }
    </div>
</div>

