@model PixelAndBit.Domain.Entities.Order

@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="pb-section pb-fade">
    <div class="mx-auto text-center" style="max-width: 34rem;">
        <div class="pb-surface pb-card pb-fade" style="backdrop-filter: blur(15px);">
            <div class="p-5">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-4 pb-receipt-pop"
                     style="width: 5rem; height: 5rem; background: rgba(195,32,173,0.16); border: 1px solid rgba(195,32,173,0.55); box-shadow: 0 0 22px rgba(195,32,173,0.22);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/>
                    </svg>
                </div>

                <h1 class="h3 mb-2 font-orbitron">Order confirmed</h1>
                <p class="text-muted mb-4">Pay at store when you pick up. Save this receipt.</p>

                <div class="p-4 mb-4" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(195,32,173,0.25); border-radius: 14px; text-align: left;">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="small text-muted text-uppercase mb-1">Order ID</div>
                            <div class="font-monospace fw-bold text-primary">@Model.Id</div>
                        </div>
                        <div class="text-end">
                            <div class="small text-muted text-uppercase mb-1">Total</div>
                            <div class="font-orbitron">@Model.TotalAmount.ToString("0.##") JOD</div>
                        </div>
                    </div>

                    <div class="mt-3 pt-3" style="border-top: 1px solid rgba(195,32,173,0.18);">
                        <div class="small text-muted text-uppercase mb-2">Items</div>
                        <div class="d-grid gap-2">
                            @foreach (var it in Model.Items)
                            {
                                <div class="d-flex justify-content-between align-items-center"
                                     style="padding: 0.65rem 0.9rem; border: 1px solid rgba(195,32,173,0.16); border-radius: 14px; background: rgba(255,255,255,0.03);">
                                    <div style="color: rgba(255,255,255,0.9);">@it.Product.Name</div>
                                    <div class="text-muted">@it.Quantity × @it.UnitPrice.ToString("0.##")</div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mt-4 pt-3" style="border-top: 1px solid rgba(195,32,173,0.18);">
                        <div class="small text-muted text-uppercase mb-1">Pixel&amp;Bit</div>
                        <div class="small" style="color: rgba(255,255,255,0.85);">Amman, Jordan</div>
                        <div class="small" style="color: rgba(255,255,255,0.85);">0785291744</div>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <a class="btn btn-primary pb-btn-glow" asp-controller="Store" asp-action="Index">Continue shopping</a>
                    <a class="btn btn-outline-primary pb-btn-glow" asp-controller="Cart" asp-action="Index">Back to cart</a>
                </div>
            </div>
        </div>
    </div>
</div>

