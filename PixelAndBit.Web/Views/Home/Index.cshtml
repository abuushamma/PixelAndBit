                <p class="text-muted mb-0">@T["Work.Subtitle"]</p>
            </div>
            <a class="btn btn-outline-primary pb-btn-glow" href="https://www.instagram.com/pixelbit.jo/" target="_blank" rel="noopener noreferrer" aria-label="@T["Work.OpenInstagramAria"]">
                @T["Work.ViewInstagram"]
            </a>
        </div>

        <div class="row g-4 mt-2">
            <div class="col-12 col-lg-4">
                <a class="pb-work2 pb-fade pb-anim pb-anim--sheen" data-pb-stagger="1" href="https://www.instagram.com/pixelbit.jo/" target="_blank" rel="noopener noreferrer"
                   style="--pb-work2-photo:url('https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1400&q=80');">
                    <div class="pb-work2-chip">@T["Work.Card1.Chip"]</div>
                    <div class="pb-work2-meta">
                        <div class="pb-work2-title">@T["Work.Card1.Title"]</div>
                        <div class="pb-work2-sub text-muted">@T["Work.Card1.Sub"]</div>
                    </div>
                </a>
            </div>
            <div class="col-12 col-lg-4">
                <a class="pb-work2 pb-fade pb-anim pb-anim--tilt" data-pb-stagger="2" href="https://www.instagram.com/pixelbit.jo/" target="_blank" rel="noopener noreferrer"
                   style="--pb-work2-photo:url('https://images.unsplash.com/photo-1591488320449-011701bb6704?auto=format&fit=crop&w=1400&q=80');">
                    <div class="pb-work2-chip">@T["Work.Card2.Chip"]</div>
                    <div class="pb-work2-meta">
                        <div class="pb-work2-title">@T["Work.Card2.Title"]</div>
                        <div class="pb-work2-sub text-muted">@T["Work.Card2.Sub"]</div>
                    </div>
                </a>
            </div>
            <div class="col-12 col-lg-4">
                <a class="pb-work2 pb-fade pb-anim pb-anim--glow" data-pb-stagger="3" href="https://www.instagram.com/pixelbit.jo/" target="_blank" rel="noopener noreferrer"
                   style="--pb-work2-photo:url('https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=1400&q=80');">
                    <div class="pb-work2-chip">@T["Work.Card3.Chip"]</div>
                    <div class="pb-work2-meta">
                        <div class="pb-work2-title">@T["Work.Card3.Title"]</div>
                        <div class="pb-work2-sub text-muted">@T["Work.Card3.Sub"]</div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

<section class="pb-saas-section pb-fade" id="actions">
    <div class="container">
        <div class="pb-saas-section-head">
            <h2 class="pb-saas-h2">@T["Action.Title"]</h2>
            <p class="text-muted mb-0">@T["Action.Subtitle"]</p>
        </div>

        <div class="row g-4 mt-2 pb-action-row">
            <div class="col-12 col-md-6 col-lg-4 d-flex">
