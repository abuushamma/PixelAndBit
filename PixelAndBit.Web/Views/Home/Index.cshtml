                    <div class="pb-service2-desc text-muted">@T["Services.Card2.Subtitle"]</div>
                    <div class="pb-service2-cta">@T["Buttons.BrowseStore"]</div>
                </a>
            </div>

            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <a class="pb-service2 pb-fade pb-anim pb-anim--rise w-100" data-pb-stagger="3" asp-controller="Booking" asp-action="Track">
                    <div class="pb-service2-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16Zm0-1A7 7 0 1 1 8 1a7 7 0 0 1 0 14Z"/>
