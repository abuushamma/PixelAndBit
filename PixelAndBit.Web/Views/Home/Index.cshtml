@inject Microsoft.Extensions.Localization.IStringLocalizer<PixelAndBit.Web.SharedResource> T

@{
    ViewData["Title"] = T["Home.Title"];
}

<section class="pb-hero2 pb-fade">
    <div class="pb-hero2-bg" aria-hidden="true"></div>
    <div class="pb-hero2-aurora" aria-hidden="true"></div>
    <div class="pb-hero2-grid" aria-hidden="true"></div>
    <div class="pb-hero2-sparks" aria-hidden="true">
        <span class="pb-spark"></span>
        <span class="pb-spark"></span>
        <span class="pb-spark"></span>
    </div>

    <div class="container pb-hero2-inner">
        <div class="row align-items-center g-4 g-lg-5">
            <div class="col-12 col-lg-6">
                <div class="pb-hero2-kicker pb-fade">@T["Home.Hero.Kicker"]</div>
                <h1 class="pb-hero2-title pb-fade">
                    <span class="pb-hero2-grad">@T["Home.Hero.Title"]</span>
                </h1>
                <p class="pb-hero2-sub pb-fade">
                    @T["Home.Hero.Sub"]
                </p>

                <div class="pb-hero2-cta pb-fade">
                    <a class="btn btn-primary btn-lg pb-btn-glow pb-hero2-primary" asp-controller="Booking" asp-action="Index">@T["Home.CTA.Book"]</a>
                    <a class="btn btn-outline-primary btn-lg pb-btn-glow" asp-controller="Booking" asp-action="Track">@T["Home.CTA.Track"]</a>
                    <a class="pb-hero2-link" href="#work">@T["Home.CTA.ViewWork"]</a>
                </div>

                <div class="pb-hero2-stats pb-fade" aria-label="@T["Hero.Stats.Aria"]">
                    <div class="pb-hero2-stat">
                        <div class="pb-hero2-stat-top">@T["Hero.Stat1.Top"]</div>
                        <div class="pb-hero2-stat-sub">@T["Hero.Stat1.Sub"]</div>
                    </div>
                    <div class="pb-hero2-stat">
                        <div class="pb-hero2-stat-top">@T["Hero.Stat2.Top"]</div>
                        <div class="pb-hero2-stat-sub">@T["Hero.Stat2.Sub"]</div>
                    </div>
                    <div class="pb-hero2-stat">
                        <div class="pb-hero2-stat-top">@T["Hero.Stat3.Top"]</div>
                        <div class="pb-hero2-stat-sub">@T["Hero.Stat3.Sub"]</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="pb-hero2-visual pb-fade" aria-label="@T["Hero.Visual.Aria"]" data-parallax data-parallax-strength="10">
                    <div class="pb-hero2-orb" aria-hidden="true"></div>
                    <div class="pb-hero2-panel" data-parallax data-parallax-strength="14">
                        <div class="pb-hero2-panel-top">
                            <div class="pb-dot"></div>
                            <div class="pb-dot"></div>
                            <div class="pb-dot"></div>
                            <div class="pb-hero2-panel-title">@T["Hero.Visual.Title"]</div>
                        </div>
                        <div class="pb-hero2-panel-body">
                            <div class="pb-hero2-card" data-parallax data-parallax-strength="18">
                                <div class="pb-hero2-card-title">@T["Hero.Visual.Card1.Title"]</div>
                                <div class="pb-hero2-line"></div>
                                <div class="pb-hero2-line pb-hero2-line--short"></div>
                                <div class="pb-hero2-pills">
                                    <span class="pb-pill">@T["Hero.Visual.Card1.Pill1"]</span>
                                    <span class="pb-pill">@T["Hero.Visual.Card1.Pill2"]</span>
                                    <span class="pb-pill">@T["Hero.Visual.Card1.Pill3"]</span>
                                </div>
                            </div>
                            <div class="pb-hero2-card pb-hero2-card--accent" data-parallax data-parallax-strength="22">
                                <div class="pb-hero2-card-title">@T["Hero.Visual.Card2.Title"]</div>
                                <div class="pb-hero2-progress" aria-hidden="true">
                                    <span class="pb-hero2-step pb-hero2-step--on"></span>
                                    <span class="pb-hero2-step pb-hero2-step--on"></span>
                                    <span class="pb-hero2-step"></span>
                                    <span class="pb-hero2-step"></span>
                                </div>
                                <div class="pb-hero2-line"></div>
                                <div class="pb-hero2-line pb-hero2-line--short"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- removed per request -->
            </div>
        </div>
    </div>
</section>

<section class="pb-benefits-strip pb-fade" aria-label="Benefits">
    <div class="container">
        <div class="row g-3">
            <div class="col-12 col-md-4 d-flex">
                <div class="pb-benefit pb-anim pb-anim--rise w-100" data-pb-stagger="1">
                    <div class="pb-benefit-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="pb-benefit-title">@T["Benefits.Card1.Title"]</div>
                        <div class="pb-benefit-sub text-muted">@T["Benefits.Card1.Sub"]</div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4 d-flex">
                <div class="pb-benefit pb-anim pb-anim--tilt w-100" data-pb-stagger="2">
                    <div class="pb-benefit-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M1 0 0 1l2.2 3.081a.5.5 0 0 0 .657.288l2.2-.79a.5.5 0 0 1 .645.334l.52 1.81a.5.5 0 0 1-.334.645l-2.2.79a.5.5 0 1 0 .364.857l2.2-.79a1.5 1.5 0 0 0 .96-1.89l-.52-1.81a1.5 1.5 0 0 0-1.334-1.056l-2.2.79a.5.5 0 1 1-.645-.334L5 3.79l-.09-.364a.5.5 0 0 1 .334-.645l2.2-.79a.5.5 0 0 1 .645.334l.52 1.81a1.5 1.5 0 0 0 .96 1.89l1.842.732a.5.5 0 0 1 .334.645L13 12l.09.364a.5.5 0 0 1-.334.645l-2.2.79a.5.5 0 0 1-.645-.334L9.5 11.79a.5.5 0 0 0-.657-.288L1 13Z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="pb-benefit-title">@T["Benefits.Card2.Title"]</div>
                        <div class="pb-benefit-sub text-muted">@T["Benefits.Card2.Sub"]</div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4 d-flex">
                <div class="pb-benefit pb-anim pb-anim--glow w-100" data-pb-stagger="3">
                    <div class="pb-benefit-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M5.52.359A.5.5 0 0 1 6 0h4a.5.5 0 0 1 .474.658L8.38 3.5h4.237a.5.5 0 0 1 .468.616l-.41 1.588a2.5 2.5 0 0 1-2.392 1.86H8.5l-.5 1h-2l-.5-1H1.5a.5.5 0 0 1-.5-.5v-1.5H5.5a.5.5 0 0 1 .447-.276l.5-1a.5.5 0 0 1 .553-.224H8V3.5H5.5a.5.5 0 0 1-.447-.276L5.52.359z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="pb-benefit-title">@T["Benefits.Card3.Title"]</div>
                        <div class="pb-benefit-sub text-muted">@T["Benefits.Card3.Sub"]</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pb-saas-section pb-fade" id="value">
    <div class="container">
        <div class="pb-saas-section-head">
            <div class="pb-saas-eyebrow">@T["Value.Eyebrow"]</div>
            <h2 class="pb-saas-h2">@T["Value.Title"]</h2>
            <p class="text-muted mb-0">@T["Value.Subtitle"]</p>
        </div>
        <div class="row g-4 mt-2">
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="pb-saas-card pb-anim pb-anim--rise w-100" data-pb-stagger="1">
                    <div class="pb-saas-card-title">@T["Value.Card1.Title"]</div>
                    <div class="text-muted">@T["Value.Card1.Sub"]</div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="pb-saas-card pb-anim pb-anim--glow w-100" data-pb-stagger="2">
                    <div class="pb-saas-card-title">@T["Value.Card2.Title"]</div>
                    <div class="text-muted">@T["Value.Card2.Sub"]</div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="pb-saas-card pb-anim pb-anim--tilt w-100" data-pb-stagger="3">
                    <div class="pb-saas-card-title">@T["Value.Card3.Title"]</div>
                    <div class="text-muted">@T["Value.Card3.Sub"]</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pb-saas-section pb-fade" id="features">
    <div class="container">
        <div class="pb-saas-section-head">
            <div class="pb-saas-eyebrow">@T["Features.Eyebrow"]</div>
            <h2 class="pb-saas-h2">@T["Features.Title"]</h2>
        </div>

        <div class="row g-4 mt-2">
            <div class="col-12 col-lg-6 d-flex">
                <div class="pb-saas-card pb-saas-card--tall pb-anim pb-anim--sheen w-100 d-flex flex-column" data-pb-stagger="1">
                    <div class="pb-saas-card-title">@T["Features.Card1.Title"]</div>
                    <div class="text-muted">@T["Features.Card1.Subtitle"]</div>
                    <div class="pb-saas-card-subgrid mt-3">
                        <div class="pb-saas-mini">@T["Features.Card1.Tag1"]</div>
                        <div class="pb-saas-mini">@T["Features.Card1.Tag2"]</div>
                        <div class="pb-saas-mini">@T["Features.Card1.Tag3"]</div>
                        <div class="pb-saas-mini">@T["Features.Card1.Tag4"]</div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6 d-flex">
                <div class="pb-saas-card pb-saas-card--tall pb-anim pb-anim--pop w-100 d-flex flex-column" data-pb-stagger="2">
                    <div class="pb-saas-card-title">@T["Features.Card2.Title"]</div>
                    <div class="text-muted">@T["Features.Card2.Subtitle"]</div>
                    <div class="mt-auto pt-3">
                        <a class="btn btn-outline-primary pb-btn-glow" asp-controller="Store" asp-action="Index">@T["Buttons.BrowseStore"]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pb-saas-section pb-fade" id="services">
