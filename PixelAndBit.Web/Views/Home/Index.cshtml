            </div>

            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <a class="pb-service2 pb-fade pb-anim pb-anim--glow w-100" data-pb-stagger="2" asp-controller="Store" asp-action="Index">
                    <div class="pb-service2-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M2.97 1.35A1 1 0 0 1 3.73 1h8.54a1 1 0 0 1 .76.35l2.61 3.05a1 1 0 0 1 .2.63V7a2 2 0 0 1-2 2h-.5v5a1 1 0 0 1-1 1H4.66a1 1 0 0 1-1-1V9h-.5a2 2 0 0 1-2-2V5.03a1 1 0 0 1 .2-.63l2.61-3.05ZM4.66 9v5h6.68V9H4.66Z"/>
                        </svg>
                    </div>
