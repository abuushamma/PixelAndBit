        <div class="pb-saas-section-head">
            <div class="pb-saas-eyebrow">@T["Services.Eyebrow"]</div>
            <h2 class="pb-saas-h2">@T["Services.Title"]</h2>
            <p class="text-muted mb-0">@T["Services.Subtitle"]</p>
        </div>

        <div class="row g-4 mt-2">
            <div class="col-12 col-md-6 col-lg-4 d-flex">
