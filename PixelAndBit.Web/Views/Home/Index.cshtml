                    <div class="pb-saas-card-title">@T["Action.Booking.Title"]</div>
                    <div class="text-muted">@T["Action.Booking.Subtitle"]</div>
                    <a class="btn btn-outline-primary w-100 pb-btn-glow pb-action-btn mt-auto" asp-controller="Booking" asp-action="Index">@T["Action.Booking.Button"]</a>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="pb-saas-card pb-action-card pb-anim pb-anim--pop w-100 d-flex flex-column" data-pb-stagger="2">
                    <div class="pb-saas-card-title">@T["Action.Tracking.Title"]</div>
                    <div class="text-muted">@T["Action.Tracking.Subtitle"]</div>
                    <a class="btn btn-outline-primary w-100 pb-btn-glow pb-action-btn mt-auto" asp-controller="Booking" asp-action="Track">@T["Action.Tracking.Button"]</a>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="pb-saas-card pb-action-card pb-anim pb-anim--glow w-100 d-flex flex-column" data-pb-stagger="3">
                    <div class="pb-saas-card-title">@T["Action.Contact.Title"]</div>
                    <div class="text-muted">@T["Action.Contact.Subtitle"]</div>
                    <a class="btn btn-outline-primary w-100 pb-btn-glow pb-action-btn mt-auto" href="https://wa.me/962785291744" target="_blank" rel="noopener noreferrer">@T["Action.Contact.Button"]</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pb-visit pb-fade" id="visit">
    <div class="pb-visit-bg" aria-hidden="true"></div>
    <div class="container">
        <div class="pb-visit-inner">
            <div class="pb-visit-copy">
                <div class="pb-visit-title pb-anim pb-anim--rise" data-pb-stagger="1">@T["Visit.Title"]</div>
                <div class="pb-visit-desc text-muted pb-anim pb-anim--rise" data-pb-stagger="2">@T["Visit.Description"]</div>
            </div>
            <div class="pb-visit-actions pb-anim pb-anim--pop" data-pb-stagger="3">
                <a class="btn btn-primary btn-lg pb-btn-glow pb-visit-btn"
                   href="https://www.google.com/maps/place/Pixel%26bit/%4032.0207621,35.9043105,15z/data=!4m6!3m5!1s0x151b61d6e8f273a5:0xa63cf2fb0dc9184f!8m2!3d32.010135!4d35.945852!16s%2Fg%2F11z2wkcm62?entry=ttu&g_ep=EgoyMDI2MDQxNC4wIKXMDSoASAFQAw%3D%3D"
                   target="_blank" rel="noopener noreferrer"
                   aria-label="@T["Visit.ButtonAria"]">
                    <span>@T["Visit.Button"]</span>
                </a>
            </div>
        </div>
    </div>
</section>
