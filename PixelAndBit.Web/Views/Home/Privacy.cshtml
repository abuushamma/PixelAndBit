@inject Microsoft.Extensions.Localization.IStringLocalizer<PixelAndBit.Web.SharedResource> T

@{
    ViewData["Title"] = T["Privacy.Title"];
}

<div class="pb-section pb-fade">
    <h1 class="pb-title mb-3">@T["Privacy.Title"]</h1>
    <p class="text-muted">@T["Privacy.Lead"]</p>

    <section class="mt-4 pb-surface pb-card p-4" id="warranty" style="border-radius: 16px; border: 1px solid rgba(157,78,221,0.22);">
        <h2 class="h4 font-orbitron mb-3">@T["Privacy.WarrantyTitle"]</h2>
        <p class="mb-0" style="color: rgba(255,255,255,0.88); line-height: 1.65;">@T["Privacy.WarrantyBody"]</p>
    </section>
</div>
